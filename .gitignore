# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# testing / coverage
/coverage
**/coverage

# build output
/build
frontend/dist

# env — never commit real secrets (see *.env.example for the shape)
.env
.env.*
!.env.example
!**/.env.example

# tooling output (graphify analysis, audit screenshots, playwright artifacts)
graphify-out/
**/graphify-out/
.audit-artifacts/
**/audit/
.playwright-mcp/
**/.playwright-mcp/

# misc
.DS_Store
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
