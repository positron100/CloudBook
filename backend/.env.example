# Copy to backend/.env for local dev. In production set these in the Render
# dashboard (Environment). Never commit the real .env.

# MongoDB connection string (MongoDB Atlas).
# The value currently baked into the old code is COMPROMISED (it was committed to
# git history) — provision a NEW Atlas database user and use its URI here.
MONGO_URI=

# JWT signing secret. The current production value is "TokenSignature".
# Keep that exact value for now so existing logged-in users are not signed out;
# rotate it later in a coordinated window (all sessions invalidate on change).
JWT_SECRET=TokenSignature

# Port to listen on. Render sets this automatically; local dev defaults to 5000.
PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
# Local dev: leave blank to allow any origin.
# Production: https://<your-vercel-domain>
CORS_ORIGIN=
