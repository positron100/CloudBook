# Copy to `.env` for local dev. In production set the same names as Vercel
# Environment Variables. Only VITE_-prefixed vars reach the browser bundle.

# Base URL of the CloudBook Backend (Express, deployed on Render).
# Local backend: http://localhost:5000
VITE_API_URL=http://localhost:5000

# --- The About-page letter (api/contact.ts, a Vercel Edge function) --------
# Unprefixed on purpose: only VITE_-prefixed vars reach the browser bundle, so
# these stay server-side only. Same shape as the Portfolio project.

# Resend API key. Read by api/_contact.ts, never reaches the browser bundle.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where letters are delivered.
CONTACT_EMAIL=mukuknegi2005@gmail.com

# The verified sender the mail is actually sent as. Must be an address on a
# domain verified with Resend. The writer's own address cannot go here
# (SPF/DKIM would fail); it is set as Reply-To instead, so replying reaches
# them directly. Resend's shared sender works for testing:
EMAIL_FROM=CloudBook <onboarding@resend.dev>
